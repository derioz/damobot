# ==============================================================================
# DamoBot Environment Configuration Template (.env.example / .dev.vars.example)
# ==============================================================================
# Copy this file to '.dev.vars' for local Cloudflare Workers development:
#   cp .env.example .dev.vars
# Or set these variables in Cloudflare Dashboard: Workers & Pages -> Settings -> Variables
#
# IMPORTANT: NEVER commit your real '.env' or '.dev.vars' file with live secrets!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DISCORD APPLICATION & AUTHENTICATION (Required)
# ------------------------------------------------------------------------------
# Discord Developer Portal -> Your App -> General Information -> Application ID
DISCORD_APPLICATION_ID="your_discord_application_id_here"

# Discord Developer Portal -> Your App -> General Information -> Public Key
# Used to cryptographically verify inbound interaction webhooks (Ed25519)
DISCORD_PUBLIC_KEY="your_discord_public_key_hex_here"

# Discord Developer Portal -> Your App -> Bot -> Reset Token
# Used by scripts/register-commands.js to register slash commands with Discord
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# Primary Discord Guild (Server) ID
# Discord App -> Right click your server -> Copy Server ID
DISCORD_GUILD_ID="your_discord_guild_id_here"

# Optional bearer secret for external /messages and /events endpoints
MESSAGE_ENDPOINT_SECRET="optional_random_secret_token_here"

# ------------------------------------------------------------------------------
# 2. COMMUNITY & FIVEM BRANDING (Optional, with smart defaults)
# ------------------------------------------------------------------------------
COMMUNITY_NAME="Your FiveM Community"
COMMUNITY_SHORT_NAME="YFC"
COMMUNITY_WEBSITE_URL="https://example.com"
LOGO_URL="https://example.com/logo.png"
BRAND_COLOR="#FAA200"

# Optional FiveM Server Details for community reference
FIVEM_SERVER_IP="play.example.com"
FIVEM_SERVER_PORT="30120"

# ------------------------------------------------------------------------------
# 3. DISCORD ROLES CONFIGURATION
# ------------------------------------------------------------------------------
# Base Staff Team role ID (Grants access to internal staff commands and panels)
STAFF_TEAM_ROLE_ID="your_staff_team_role_id_here"

# Server Owner role ID (Grants superadmin bypass)
OWNER_ROLE_ID="your_owner_role_id_here"

# Management role ID (Grants LOA approval/denial and punishment review rights)
VRP_MANAGEMENT_ROLE_ID="your_management_role_id_here"

# Staff LOA role ID (Assigned to staff members during an active Leave of Absence)
STAFF_LOA_ROLE_ID="your_staff_loa_role_id_here"

# Support Staff role ID (Notified on support reminders and staff requests)
SUPPORT_STAFF_ROLE_ID="your_support_staff_role_id_here"

# Moderator role ID (Notified on moderator reminders)
MODERATOR_ROLE_ID="your_moderator_role_id_here"

# ------------------------------------------------------------------------------
# 4. DISCORD CHANNELS CONFIGURATION
# ------------------------------------------------------------------------------
# Channel where the Staff LOA interactive panel is stationed
LOA_CHANNEL_ID="your_loa_channel_id_here"

# Private channel where LOA requests, approvals, and returns are logged
LOA_LOG_CHANNEL_ID="your_loa_log_channel_id_here"

# Private channel where staff log player bans, warnings, and kicks
PUNISHMENT_LOG_CHANNEL_ID="your_punishment_log_channel_id_here"

# Private channel where player asset/cash refund records are logged
REFUND_LOG_CHANNEL_ID="your_refund_log_channel_id_here"

# Public channel where community members submit and vote on suggestions
SUGGESTIONS_CHANNEL_ID="your_suggestions_channel_id_here"

# Staff support chat channel for ticket reminder cron notifications
TICKET_REMINDER_CHANNEL_ID="your_ticket_reminder_channel_id_here"

# ------------------------------------------------------------------------------
# 5. GOOGLE SHEETS DUAL-SYNC INTEGRATION (Optional)
# ------------------------------------------------------------------------------
# If you wish to dual-write punishments, refunds, and referrals to Google Sheets
# in addition to Cloudflare D1 SQL, configure your Google Service Account below.
# Leave blank to use Cloudflare D1 storage only.
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-gcp-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_google_service_account_private_key_here\n-----END PRIVATE KEY-----\n"

# Spreadsheet ID for Punishments
PUNISHMENT_SHEET_ID="your_punishment_google_sheet_id_here"
PUNISHMENT_SHEET_TAB="Punishment Logs"
PUNISHMENT_AUDIT_TAB="Punishment Audits"

# Spreadsheet ID for Refunds
REFUND_SHEET_ID="your_refund_google_sheet_id_here"
REFUND_SHEET_TAB="Refund Log"
REFUND_AUDIT_TAB="Refund Audits"

# Spreadsheet ID for Player Referrals
GOOGLE_SHEET_ID="your_referrals_google_sheet_id_here"
GOOGLE_SHEET_TAB="Referral Tracker"

# ------------------------------------------------------------------------------
# 6. FEATURE FLAGS
# ------------------------------------------------------------------------------
# Enable or disable automated ticket reminder cron processor ("true" | "false")
REMINDERS_ENABLED="false"
