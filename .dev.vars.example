# Discord Application Public Key (Discord Developer Portal -> General Information -> Public Key)
DISCORD_PUBLIC_KEY="your_discord_public_key_here"

# Discord Application ID (Discord Developer Portal -> General Information -> Application ID)
DISCORD_APPLICATION_ID="your_discord_application_id_here"

# Discord Bot Token (Discord Developer Portal -> Bot -> Token)
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# Discord Test Server Guild ID (Discord App -> Right click your server -> Copy Server ID)
DISCORD_GUILD_ID="your_discord_guild_id_here"

# Google Sheets Configuration
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
