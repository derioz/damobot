{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "damo-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": true
  },
  "vars": {
    // Discord Application & Guild
    "DISCORD_APPLICATION_ID": "YOUR_DISCORD_APPLICATION_ID",
    "DISCORD_GUILD_ID": "YOUR_DISCORD_GUILD_ID",

    // Community Branding
    "COMMUNITY_NAME": "Your FiveM Server",
    "COMMUNITY_SHORT_NAME": "YFS",
    "COMMUNITY_WEBSITE_URL": "https://example.com",
    "LOGO_URL": "https://example.com/logo.png",
    "BRAND_COLOR": "#FAA200",

    // Staff Role IDs
    "STAFF_TEAM_ROLE_ID": "YOUR_STAFF_TEAM_ROLE_ID",
    "OWNER_ROLE_ID": "YOUR_OWNER_ROLE_ID",
    "VRP_MANAGEMENT_ROLE_ID": "YOUR_MANAGEMENT_ROLE_ID",
    "STAFF_LOA_ROLE_ID": "YOUR_STAFF_LOA_ROLE_ID",
    "SUPPORT_STAFF_ROLE_ID": "YOUR_SUPPORT_STAFF_ROLE_ID",
    "MODERATOR_ROLE_ID": "YOUR_MODERATOR_ROLE_ID",

    // Channel IDs
    "LOA_CHANNEL_ID": "YOUR_LOA_CHANNEL_ID",
    "LOA_LOG_CHANNEL_ID": "YOUR_LOA_LOG_CHANNEL_ID",
    "PUNISHMENT_LOG_CHANNEL_ID": "YOUR_PUNISHMENT_LOG_CHANNEL_ID",
    "REFUND_LOG_CHANNEL_ID": "YOUR_REFUND_LOG_CHANNEL_ID",
    "SUGGESTIONS_CHANNEL_ID": "YOUR_SUGGESTIONS_CHANNEL_ID",
    "TICKET_REMINDER_CHANNEL_ID": "YOUR_TICKET_REMINDER_CHANNEL_ID",

    // Google Sheets Integration (Optional - leave blank if using D1 only)
    "PUNISHMENT_SHEET_ID": "YOUR_PUNISHMENT_GOOGLE_SHEET_ID",
    "PUNISHMENT_SHEET_TAB": "Punishment Logs",
    "PUNISHMENT_AUDIT_TAB": "Punishment Audits",
    "REFUND_SHEET_ID": "YOUR_REFUND_GOOGLE_SHEET_ID",
    "REFUND_SHEET_TAB": "Refund Log",
    "REFUND_AUDIT_TAB": "Refund Audits",

    // Feature Flags
    "REMINDERS_ENABLED": "false"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "PUNISHMENT_DB",
      "database_name": "damo-bot-punishments",
      "database_id": "YOUR_PUNISHMENT_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    },
    {
      "binding": "REFUND_DB",
      "database_name": "damo-bot-refunds",
      "database_id": "YOUR_REFUND_D1_DATABASE_ID",
      "migrations_dir": "migrations_refunds"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STICKY_BOT",
        "class_name": "StickyBotDO"
      },
      {
        "name": "STAFF_LOA",
        "class_name": "StaffLoaDO"
      },
      {
        "name": "PUNISHMENT_SEQUENCE",
        "class_name": "PunishmentSequenceDO"
      },
      {
        "name": "SUGGESTIONS",
        "class_name": "SuggestionsDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StickyBotDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "StaffLoaDO"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "PunishmentSequenceDO"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "SuggestionsDO"
      ]
    }
  ]
}
